auto-install-peers=true
strict-peer-dependencies=false

# Build scripts pnpm 10+ blocks by default. All known-safe legitimate
# native/build deps used by our stack. Keep in sync with the
# pnpm.onlyBuiltDependencies block in package.json.
only-built-dependencies[]=@clerk/shared
only-built-dependencies[]=@prisma/client
only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=esbuild
only-built-dependencies[]=prisma
only-built-dependencies[]=protobufjs
only-built-dependencies[]=sharp
only-built-dependencies[]=unrs-resolver
only-built-dependencies[]=@google/genai
only-built-dependencies[]=bufferutil

# Don't kill `pnpm dev` just because pnpm's auto dep-status check
# reports a warning. Without this, an ignored-builds notice becomes a
# hard exit-1 that blocks development.
verify-deps-before-run=warn
